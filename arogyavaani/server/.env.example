# ---- Agora (Console -> Project). ConvoAI must be enabled on the project.
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ---- Public URL of THIS backend's custom-LLM endpoint (Agora cloud calls it; never localhost)
CUSTOM_LLM_URL=https://<your-tunnel-or-aws-host>/llm/chat/completions
CUSTOM_LLM_API_KEY=change-me-long-random      # Agora sends it as Authorization: Bearer; we validate it
CUSTOM_LLM_MODEL=arogya-agent
PUBLIC_BASE_URL=https://<your-tunnel-or-aws-host>   # used for voice-note / .ics media URLs

# ---- Our brain: any OpenAI-compatible provider (OpenAI, Azure, Amazon Bedrock gateway, Anthropic's OpenAI endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_key
LLM_MODEL=gpt-4o-mini
# Optional failover, used when the primary fails before the first token
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# ---- ASR: sarvam (hi-IN / kn-IN / en-IN) or ares (fallback: en-IN,hi-IN)
ASR_VENDOR=sarvam
SARVAM_API_KEY=your_sarvam_key

# ---- TTS: Murf Falcon. Pick ONE voice that supports hi-IN, kn-IN and en-IN: python scripts/murf_voices.py
MURF_API_KEY=your_murf_key
MURF_VOICE_ID=
MURF_BASE_URL=wss://in.api.murf.ai/v1/speech/stream-input
MURF_HTTP_BASE=https://in.api.murf.ai

# ---- Optional messaging (falls back to the in-app inbox when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
DEMO_PATIENT_PHONE=
DEMO_CAREGIVER_PHONE=

# ---- Console + demo
CONSOLE_PASSWORD=nurse
DEMO_MODE=1
HOLD_TTL_S=120
# AROGYA_DB_PATH=arogya.db
# GEOCODE_NOMINATIM=1   # real geocoding path (local table is used by default)
# HEALTHZ_DEEP=1        # /healthz also pings the Murf API
